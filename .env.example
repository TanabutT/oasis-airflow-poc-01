# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local
#   ./scripts/gen-secrets.sh >> .env.local   (then delete the empty AIRFLOW_FERNET_KEY= / AIRFLOW_JWT_SECRET= lines)
AIRFLOW_VERSION=3.3.2
PYTHON_VERSION=3.12
AIRFLOW_IMAGE_NAME=oasis-airflow:3.3.2-python3.12

# Linux: output of `id -u`. macOS: keep 50000.
AIRFLOW_UID=50000
# Linux only: GID of the docker group, `getent group docker | cut -d: -f3`. Lets Airflow use the Docker socket.
DOCKER_GID=0

AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=airflow

# Generated by scripts/gen-secrets.sh
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# RustFS (S3-compatible). Keys are chosen by you and used by both the server and the clients.
RUSTFS_IMAGE_TAG=1.0.1
RUSTFS_ACCESS_KEY=change-me-access
RUSTFS_SECRET_KEY=change-me-secret-min-8-chars
RUSTFS_BUCKET=oasis-archive
ICEBERG_NAMESPACE=analytics

# Pipeline
INGEST_ENGINE=polars          # polars | spark
API_BASE_URL=                 # leave empty to skip the REST API source
API_TOKEN=
API_ORDERS_PATH=/orders
